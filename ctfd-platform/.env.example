# Copy to .env on the CTFd server and fill in. Never commit .env.
# See PRODUCTION.md.

# Load the production layer with every plain `docker compose` command.
COMPOSE_FILE=docker-compose.yml:docker-compose.production.yml

# The CTFd site. A bare hostname gets HTTPS automatically; use
# http://ctf.example.edu if the server is not reachable from the internet.
CTF_SITE=ctf.tu-tuwaiq.site

# Team instances are served at http://<instance>.CHALLENGE_DOMAIN/.
# Needs a wildcard DNS record: *.chal.example.edu -> this server.
CHALLENGE_DOMAIN=chal.tu-tuwaiq.site
